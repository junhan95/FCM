# ─────────────────────────────────────────────────────────
# FCM 환경변수 예시 — 복사해서 .env 로 사용하십시오.
# .env 는 절대 커밋하지 마십시오 (.gitignore 에 등록됨)
# ─────────────────────────────────────────────────────────

# 부트스트랩용 슈퍼유저 — 롤/DB 생성에만 사용
DATABASE_URL_SUPER=postgres://postgres:devonly@localhost:5433/fcm

# 스키마 소유자 — 마이그레이션·시드 전용 (슈퍼유저가 아니어야 함)
DATABASE_URL_OWNER=postgres://fcm_owner:devonly@localhost:5433/fcm

# 애플리케이션 런타임 — 비소유 롤. RLS 가 이 롤에 적용된다.
# 이 롤을 소유자나 슈퍼유저로 바꾸면 격리가 무력화된다.
DATABASE_URL_APP=postgres://fcm_app:devonly@localhost:5433/fcm

NODE_ENV=development

# Generated locally by ../scripts/configure-local.mjs; never publish the value.
# FCM_BRIDGE_SECRET=
FCT_PORT=3001
COOKIE_SECURE=0
