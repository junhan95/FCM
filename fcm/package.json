{
  "name": "fcm",
  "version": "0.1.0",
  "private": true,
  "description": "Frankonia Customer Management",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run tests/isolation.test.ts tests/auth.test.ts tests/import.test.ts tests/portal.test.ts",
    "test:isolation": "vitest run tests/isolation.test.ts",
    "lint": "next lint",
    "test:smoke": "vitest run tests/http-smoke.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.6",
    "exceljs": "^4.4.0",
    "next": "^15.5.4",
    "papaparse": "^5.7.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  }
}
